-- ==================== VALUES ====================
local V={["Garama and Madundung"]=1,["Dragon Cannelloni"]=22,["Hydra Dragon Cannelloni"]=26,["Hydra Serpent"]=12,["Sammyni Truckini"]=5,["Sammyni Fattini"]=3,["Capitano Moby"]=2,["Cerberus"]=3,["Strawberrita"]=6.5}
local MUT_MULT={["None"]=1.0,["Cyber"]=5.0,["Divine"]=5.0,["Phantom"]=5.0,["Crystal"]=5.0,["Eclipse"]=5.0,["Candy"]=2.0,["Radioactive"]=4.0,["Lava"]=4.0,["Galaxy"]=4.0,["Yin Yang"]=4.0,["Cursed"]=4.0,["Rainbow"]=4.0,["Gold"]=4.0,["Diamond"]=4.0,["Gold and Diamond"]=4.0}
local MUT_ALIAS={["YinYang"]="Yin Yang",["Yin-Yang"]="Yin Yang",["GoldDiamond"]="Gold and Diamond"}

local function mutOf(r) if not r or r=="" or r=="None" then return "None" end local s=tostring(r):gsub("^%s+",""):gsub("%s+$",""):gsub("<[^>]+>","") return MUT_ALIAS[s] or (MUT_MULT[s] and s) or s end
local function itemValue(e) if type(e)~="table" then return 0 end local b=V[e.Index]; if not b then return 0 end return b*(MUT_MULT[mutOf(e.Mutation)] or 1.0) end
local function listValue(l) local t=0 if type(l)~="table" then return 0 end for _,e in ipairs(l) do t=t+itemValue(e) end return t end

-- ==================== CORE ====================
local function pg() return LP:FindFirstChild("PlayerGui") end
local function getTradeRoot() local p=pg(); if not p then return nil end local tl=p:FindFirstChild("TradeLiveTrade"); if not tl then return nil end return tl:FindFirstChild("TradeLiveTrade") or tl end
local function getPartnerName() local t=getTradeRoot(); if not t then return nil end local o=t:FindFirstChild("Other"); if not o then return nil end local u=o:FindFirstChild("Username"); if u and u:IsA("TextLabel") then return u.Text:match("@([%w_]+)") end return nil end
local function tradeOpen() local t=getTradeRoot(); if not t then return false end return t:FindFirstChild("Other")~=nil end

local function readSideCards(sideName)
    local t=getTradeRoot(); if not t then return {} end
    local side=t:FindFirstChild(sideName); if not side then return {} end
    local sf=side:FindFirstChild("ScrollingFrame"); if not sf then return {} end
    local out,seen={},{}
    for _,card in ipairs(sf:GetDescendants()) do
        if card:IsA("GuiObject") then
            local spacer=card:FindFirstChild("Spacer",true)
            local title=spacer and spacer:FindFirstChild("Title")
            if title and type(title.Text)=="string" and title.Text~="" then
                local clean=title.Text:gsub("<[^>]+>",""):gsub("^%s+",""):gsub("%s+$","")
                if clean~="" and clean~="Brainrot Name" and clean~="Template" then
                    local key=spacer:GetFullName()
                    if not seen[key] then
                        seen[key]=true
                        local mut=nil
                        for _,d in ipairs(spacer:GetDescendants()) do
                            if d:IsA("TextLabel") and d~=title and type(d.Text)=="string" then
                                local m=mutOf(d.Text)
                                if MUT_MULT[m] and m~="None" then mut=m; break end
                            end
                        end
                        out[#out+1]={Index=clean,Mutation=mut}
                    end
                end
            end
        end
    end
    return out
end

-- ==================== AUTOMATED CLICKER ====================
local function clickItemInInventory(itemName)
    local t=getTradeRoot()
    if not t then return false end
    local mySide=t:FindFirstChild("Your")
    local sf=mySide and mySide:FindFirstChild("ScrollingFrame")
    if not sf then return false end
    
    for _, obj in ipairs(sf:GetDescendants()) do
        if obj.Name == "Spacer" then
            local title = obj:FindFirstChild("Title", true)
            if title and string.find(string.lower(title.Text), string.lower(itemName)) then
                -- Calculate absolute center of the button
                local pos = obj.AbsolutePosition + (obj.AbsoluteSize / 2)
                -- Use VIM to simulate a real mouse click
                VIM:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
                task.wait(0.05)
                VIM:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
                print("[AUTO-TRADE] Clicked: " .. itemName)
                return true
            end
        end
    end
    return false
end

-- ==================== READY & CHAT ====================
local readyLock={}
local function fireReady()
    local t=getTradeRoot(); if not t then return false end
    local other=t:FindFirstChild("Other"); if not other then return false end
    local rb=other:FindFirstChild("ReadyButton")
    if not rb then return false end
    local txt=rb:FindFirstChild("Txt")
    if not txt or not txt.Text:lower():find("accept") then return false end
    local p=getPartnerName() or "?"
    if readyLock[p] and os.clock()-readyLock[p]<30 then return false end
    
    local pos = rb.AbsolutePosition + (rb.AbsoluteSize / 2)
    VIM:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
    task.wait(0.05)
    VIM:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
    readyLock[p]=os.clock()
    return true
end

local SENT_TEXTS={} local lastSayAt=0
local function getChatBox() local t=getTradeRoot(); if not t then return nil end local nc=t:FindFirstChild("Chat") and t.Chat:FindFirstChild("NormalChat") local cb=nc and nc:FindFirstChild("ChatBox") return cb and cb:FindFirstChild("TextBox") end
local function say(text) if os.clock()-lastSayAt<POLICY.chatMinGap then return false end local box=getChatBox(); if not box then return false end pcall(function() box.Text=text if firesignal then firesignal(box.FocusLost,true,Enum.KeyCode.Return) end lastSayAt=os.clock() SENT_TEXTS[text:lower()]=true end) return true end

-- ==================== MAIN LOOP ====================
local state={phase="idle",cooldownUntil=0,partner=nil,lastTheirSig=""}

task.spawn(function()
    while true do
        task.wait(0.5)
        pcall(function()
            if not tradeOpen() then
                if state.phase~="idle" then state.phase="idle" state.lastTheirSig="" state.partner=nil end
                return
            end
            
            local partner=getPartnerName()
            if state.partner~=partner then
                state.partner=partner
                state.phase="observe"
            end

            local my=readSideCards("Your"); local their=readSideCards("Other")
            local theirVal=listValue(their); local myVal=listValue(my)
            
            -- Create a signature of their side to detect changes
            local sig=""
            for _,e in ipairs(their) do sig=sig..e.Index..tostring(e.Mutation) end
            
            if sig~=state.lastTheirSig and #their>0 then
                state.lastTheirSig=sig
                local hasTarget=false
                for _,e in ipairs(their) do if POLICY.targetBrainrots[e.Index] then hasTarget=true break end end
                
                if hasTarget then
                    local margin=theirVal-myVal
                    if margin>=POLICY.minMarginToAccept then
                        state.cooldownUntil=os.clock()+POLICY.readyWaitAfterCooldown
                        state.phase="wait_partner_ready"
                    else
                        -- Lowball logic: If we don't have enough, we don't accept.
                        -- For now, we just log it.
                        print("[AUTO-TRADE] They offered target, but margin is low. Waiting for manual add.")
                    end
                end
            end
            
            if state.phase=="wait_partner_ready" and os.clock()>=state.cooldownUntil then
                local ok = fireReady()
                if ok then
                    print("[AUTO-TRADE] Fired Ready!")
                    state.phase="ready_pending"
                end
            end
        end)
    end
end)

