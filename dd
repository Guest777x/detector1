local real_loadstring = loadstring
local real_load = load

local function capture(src, chunkname)
    if type(src) == "string" and #src > 500 then
        local filename = "DECODED_" .. tostring(math.random(1000,9999)) .. ".lua"
        if writefile then
            writefile(filename, src)
            print("=== SAVED TO WORKSPACE: " .. filename .. " ===")
        end
    end
    return real_loadstring(src, chunkname)
end

loadstring = capture
load = capture
if hookfunction and getrawmetatable then
    pcall(function()
        local mt = getrawmetatable(game)
        local old = mt.__index
        setreadonly(mt, false)
        mt.__index = function(t, k)
            if k == "loadstring" or k == "load" then
                return capture
            end
            return old(t, k)
        end
        setreadonly(mt, true)
    end)
end

