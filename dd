local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LP = Players.LocalPlayer

-- The exact remote used to add items to a trade
local Net = ReplicatedStorage:WaitForChild("Packages"):WaitForChild("Net")
local AddTradeItem = Net:FindFirstChild("AddTradeItem", true) or Net:FindFirstChild("AddItem", true)

local function offerItem(itemName)
    if not AddTradeItem then
        print("Could not find AddTradeItem remote!")
        return
    end
    
    -- In most of these exploit scripts, the argument is the item's unique ID (UUID)
    -- We read your plot inventory to find the Strawberrita's ID
    local Plots = workspace:FindFirstChild("Plots")
    local myPlot = Plots and Plots:FindFirstChild(LP.Name)
    
    if myPlot then
        for _, obj in ipairs(myPlot:GetDescendants()) do
            if obj.Name == "Item" and obj:GetAttribute("Brainrot") == itemName then
                local uuid = obj:GetAttribute("UUID") or obj.Name
                print("Found " .. itemName .. "! Offering UUID: " .. uuid)
                
                -- Fire the remote to place it in the trade
                pcall(function()
                    AddTradeItem:FireServer(uuid)
                end)
                return
            end
        end
    end
    print("Could not find " .. itemName .. " on your plot.")
end

